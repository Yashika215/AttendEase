{
  "name": "attendease-smart-attendance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --packages=external --format=esm --outfile=server.js",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "node -e \"import('fs').then(fs=>{fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('server.js',{force:true});})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
