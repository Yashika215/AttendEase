# APP_URL: The URL where the application is hosted.
APP_URL="http://localhost:3000"

# SPRING_API_URL: Optional URL of the running Java Spring Boot backend (e.g., http://localhost:8080).
# When configured, Express forwards /api/* requests directly to the Spring Boot + PostgreSQL server.
SPRING_API_URL=""

# AUTH_SECRET: HMAC signing key for backend authentication tokens.
AUTH_SECRET="CHANGE_ME_AUTH_SECRET"

# SMTP Email Configuration for Automated Low-Attendance Threshold Notifications
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="alerts@attendease.edu"
